{
  "name": "reliefvue-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "build:web": "tsc --noEmit && vite build --mode public",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build && npm run build:web",
    "chain:build": "cd chain && anchor build",
    "chain:test": "cd chain && anchor test"
  },
  "dependencies": {
    "@solana-program/system": "0.15.0",
    "@solana/kit": "8.4.0",
    "@solana/wallet-standard-features": "1.5.0",
    "@wallet-standard/app": "1.1.1",
    "@wallet-standard/base": "1.1.1",
    "@wallet-standard/features": "1.1.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "prettier": "3.6.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
